sible-user-message-root" data-can-expand=""><div id="_r_59_" data-testid="collapsible-user-message-content" class="A_HxFq_content"><div class="max-w-full min-w-0 [overflow-wrap:anywhere] whitespace-pre-wrap">&lt;div style="margin:0; padding:0; background-color:#f4efea; font-family:Arial, Helvetica, sans-serif;"&gt;

  &lt;table cellspacing="0" cellpadding="0" border="0" style="width:100%; margin:0; padding:0; background-color:#f4efea;"&gt;

    &lt;tbody&gt;&lt;tr&gt;
      &lt;td style="padding:32px 12px; text-align:center;"&gt;

        &lt;table cellspacing="0" cellpadding="0" border="0" style="width:760px; max-width:760px; margin:0 auto; background-color:#faf7f3; border:1px solid #e5ddd5; border-radius:16px; overflow:hidden;"&gt;

          &lt;!-- HEADER AND GREETING --&gt;
          &lt;tbody&gt;&lt;tr&gt;
            &lt;td style="padding:38px 48px 30px 48px; text-align:center;"&gt;

              &lt;div style="font-size:36px; line-height:1.25; color:#2f2925; text-align:center;"&gt;
                &lt;span style="color:#d85f59; font-weight:700;"&gt;Impact&lt;/span&gt;
                &lt;span style="font-weight:400;"&gt; Housing&lt;/span&gt;
              &lt;/div&gt;

              &lt;p style="margin:28px 0 12px 0; font-size:20px; line-height:1.6; color:#302b27; text-align:center;"&gt;
                Hi
                &lt;strong&gt;@{outputs('Get_response_details')?['body/r88e1a6e6657a4dafb72e788e65dc8cb9']}&lt;/strong&gt;,
              &lt;/p&gt;

              &lt;p style="max-width:590px; margin:0 auto; font-size:16px; line-height:1.8; color:#5b534d; text-align:center;"&gt;
                We’re pleased to welcome you for your upcoming visit on
                &lt;strong&gt;@{formatDateTime(outputs('Get_response_details')?['body/rd1d3353ca4b54e31868c29011b372498'],'MMMM d, yyyy')}&lt;/strong&gt;.
                Please find all important visitor and arrival information below.
              &lt;/p&gt;

            &lt;/td&gt;
          &lt;/tr&gt;

          &lt;!-- VISITOR GUIDE IMAGE --&gt;
          &lt;tr&gt;
            &lt;td style="padding:0 34px; text-align:center;"&gt;

              &lt;table cellspacing="0" cellpadding="0" border="0" style="width:100%; margin:0 auto;"&gt;

                &lt;tbody&gt;&lt;tr&gt;
                  &lt;td style="text-align:center;"&gt;

                    &lt;img src="data:image/png;base64,@{body('Get_file_content')?['$content']}" alt="Impact Housing Visitor Information" width="692" style="display:block; width:100%; max-width:692px; height:auto; margin:0 auto; border:1px solid #e3dad2;"&gt;

                  &lt;/td&gt;
                &lt;/tr&gt;

              &lt;/tbody&gt;&lt;/table&gt;

            &lt;/td&gt;
          &lt;/tr&gt;

          &lt;!-- PARKING DIRECTIONS BUTTON --&gt;
          &lt;tr&gt;
            &lt;td style="padding:22px 34px 8px 34px; text-align:center;"&gt;

              &lt;table cellspacing="0" cellpadding="0" border="0" style="margin:0 auto;"&gt;

                &lt;tbody&gt;&lt;tr&gt;
                  &lt;td style="background-color:#d85f59; border-radius:7px; text-align:center;"&gt;

                    &lt;a href="https://www.google.com/maps/search/?api=1&amp;amp;query=351+S+Olive+St%2C+Los+Angeles%2C+CA+90013" style="display:inline-block; padding:13px 26px; color:#ffffff; text-decoration:none; font-size:15px; line-height:1.3; font-weight:700;"&gt;
                      Open Parking Directions
                    &lt;/a&gt;

                  &lt;/td&gt;
                &lt;/tr&gt;

              &lt;/tbody&gt;&lt;/table&gt;

              &lt;p style="margin:11px 0 0 0; font-size:13px; line-height:1.6; color:#82766c; text-align:center;"&gt;
                Parking is located at 351 S. Olive St., Los Angeles, CA 90013.
              &lt;/p&gt;

            &lt;/td&gt;
          &lt;/tr&gt;

          &lt;!-- HOST CONTACT --&gt;
          &lt;tr&gt;
            &lt;td style="padding:26px 48px 18px 48px; text-align:center;"&gt;

              &lt;table cellspacing="0" cellpadding="0" border="0" style="width:100%; margin:0 auto; background-color:#f1ebe5; border:1px solid #e0d5cc; border-radius:12px;"&gt;

                &lt;tbody&gt;&lt;tr&gt;
                  &lt;td style="padding:25px 30px; text-align:left;"&gt;

                    &lt;div style="margin-bottom:14px; font-size:14px; line-height:1.4; letter-spacing:2.5px; text-transform:uppercase; color:#82766c;"&gt;
                      Your Host
                    &lt;/div&gt;

                    &lt;p style="margin:0; font-size:15px; line-height:1.9; color:#37312d;"&gt;

                      &lt;strong&gt;Name:&lt;/strong&gt;
                      @{outputs('Get_response_details')?['body/rc700b192cb9c4a209f34386de656a6b6']}
                      &lt;br&gt;

                      &lt;strong&gt;Phone:&lt;/strong&gt;
                      &lt;a href="tel:@{outputs('Get_response_details')?['body/r61a4cced997944728db0fc627c672f3c']}" style="color:#39758c; text-decoration:none;"&gt;
                        @{outputs('Get_response_details')?['body/r61a4cced997944728db0fc627c672f3c']}
                      &lt;/a&gt;

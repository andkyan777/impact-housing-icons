\":true,\"passed\":true},\"1426425582\":{\"name\":\"1426425582\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Live-only create\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"user_prompt_key\":\"good_option\",\"enable_web_search\":false,\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\"},\"is_device_based\":false,\"passed\":false},\"3203804112\":{\"name\":\"3203804112\",\"rule_id\":\"l1cQvHcaNrOGLwWcVswwT\",\"secondary_exposures\":[{\"gate\":\"1744743680\",\"gateValue\":\"true\",\"ruleID\":\"3nVjDtIaNJ2nyoZuftIzj0\"}],\"version\":15,\"id_type\":\"userID\",\"value\":{\"upload_photos\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"2888003541\":{\"name\":\"2888003541\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"max_bytes\":31457280},\"is_device_based\":false,\"passed\":false},\"3726720227\":{\"name\":\"3726720227\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":27,\"id_type\":\"userID\",\"value\":{\"opentable\":\"asdk_app_6935ba0e15b48191ae8ad5795b213c19\",\"yelp\":\"asdk_app_69e92b0ca8708191a9c3259e162d8e2d\"},\"is_device_based\":false,\"passed\":false},\"1165494509\":{\"name\":\"1165494509\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":16,\"id_type\":\"userID\",\"value\":{\"kind\":\"username\",\"tempDisabled\":false,\"loginStrategy\":\"existing_user\",\"name\":\"phone_number\",\"enabled\":true},\"is_device_based\":false,\"passed\":false},\"301381018\":{\"name\":\"301381018\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"489084288\":{\"name\":\"489084288\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":31,\"id_type\":\"stableID\",\"value\":{\"options\":[\"google\",\"apple\",\"microsoft\",\"email\",\"phone_number\"]},\"is_device_based\":true,\"passed\":false},\"550560761\":{\"name\":\"550560761\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"local_results_limit\":2,\"history_results_limit\":6},\"is_device_based\":false,\"passed\":false},\"3583985244\":{\"name\":\"3583985244\",\"rule_i